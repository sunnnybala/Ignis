PORT=4000
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DATABASE_URL=
REDIS_URL=
CORS_ORIGIN=https://your-frontend.vercel.app
NODE_ENV=production

# ============================
# AUTH (Supabase Auth / JWT)
# ============================
# We keep the app DB on Railway Postgres; Supabase is used for Auth (identity) + Storage only.
#
# How backend auth will work (implementation next):
# - Frontend will send: Authorization: Bearer <supabase_access_token>
# - Backend will verify the JWT using the Supabase JWKS endpoint, then set req.user.id = JWT "sub"
#
# Where to get these:
# - SUPABASE_URL:
#     Supabase Dashboard → Project Settings → API → Project URL
# - SUPABASE_ANON_KEY:
#     Supabase Dashboard → Project Settings → API → anon public
#     NOTE: This key is "public" (also used in the frontend). We use it server-side only to fetch JWKS
#     in environments where Supabase requires an apikey header for JWKS endpoints.
# - SUPABASE_JWKS_URL:
#     Recommended: use the OpenID discovery jwks_uri:
#       1) GET https://<ref>.supabase.co/auth/v1/.well-known/openid-configuration
#       2) Copy jwks_uri (often: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json)
#     Some deployments return 404 for /auth/v1/certs; jwks_uri is the correct source of truth.
#     (You can derive <your-project-ref> from SUPABASE_URL: https://<ref>.supabase.co)
# - SUPABASE_JWT_ISSUER:
#     Usually: https://<your-project-ref>.supabase.co/auth/v1
# - SUPABASE_JWT_AUD:
#     Usually "authenticated" (default audience for Supabase access tokens)
#
# NOTE: These are for *verifying* user tokens. Do NOT put service-role keys in the browser.
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUD=authenticated

# Logging (recommended)
# LOG_LEVEL=debug in development; info in production.
LOG_LEVEL=info

# Modal runner (experiment execution)
# URL for your Modal runner web function (Modal prints this after `modal deploy`), e.g.
#   https://<workspace>--ignis-experiment-runner-run.modal.run
# The backend will POST directly to this URL (do NOT append "/run").
MODAL_RUNNER_URL=
# Publicly reachable base URL for this backend (used to construct callback URLs for Modal).
# Example: https://your-backend.railway.app
PUBLIC_BASE_URL=

# Modal runner expectations (not read by backend, but required for the runner to work):
# - A Modal Secret named `ignis-kaggle` containing:
#     KAGGLE_USERNAME=...
#     KAGGLE_KEY=...
# - A Modal Volume named `ignis-datasets-cache` for dataset caching (shared across jobs/users)
# Optional runner overrides (set in Modal app environment if you change defaults):
# IGNIS_KAGGLE_SECRET_NAME=ignis-kaggle
# IGNIS_DATASET_VOLUME_NAME=ignis-datasets-cache

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ignis-projects-prod

# Paper + images (vision)
# If set, paper generate/regenerate will attach the latest experiment job's PNG/JPEG images (via signed URLs).
# Recommended: use a vision-capable model like "gpt-4o".
OPENAI_PAPER_VISION_MODEL=gpt-4o
# Signed URL TTL (seconds) for images passed to the model
PAPER_IMAGE_URL_EXPIRES_SEC=900
# Max number of images to attach per generate/regenerate call (0 disables)
PAPER_MAX_IMAGE_COUNT=6

# LaTeX (Athena PDF compile)
TECTONIC_BIN=
LATEX_TIMEOUT_MS=120000

