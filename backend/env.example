PORT=4000
OPENAI_API_KEY=
DATABASE_URL=
REDIS_URL=
CORS_ORIGIN=https://your-frontend.vercel.app
NODE_ENV=production

# Modal runner (experiment execution)
# Base URL for your Modal runner service. The backend will call `${MODAL_RUNNER_URL}/run`.
MODAL_RUNNER_URL=
# Publicly reachable base URL for this backend (used to construct callback URLs for Modal).
# Example: https://your-backend.railway.app
PUBLIC_BASE_URL=

# Modal runner expectations (not read by backend, but required for the runner to work):
# - A Modal Secret named `ignis-kaggle` containing:
#     KAGGLE_USERNAME=...
#     KAGGLE_KEY=...
# - A Modal Volume named `ignis-datasets-cache` for dataset caching (shared across jobs/users)
# Optional runner overrides (set in Modal app environment if you change defaults):
# IGNIS_KAGGLE_SECRET_NAME=ignis-kaggle
# IGNIS_DATASET_VOLUME_NAME=ignis-datasets-cache

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ignis-projects-prod

# Paper + images (vision)
# If set, paper generate/regenerate will attach the latest experiment job's PNG/JPEG images (via signed URLs).
# Recommended: use a vision-capable model like "gpt-4o".
OPENAI_PAPER_VISION_MODEL=gpt-4o
# Signed URL TTL (seconds) for images passed to the model
PAPER_IMAGE_URL_EXPIRES_SEC=900
# Max number of images to attach per generate/regenerate call (0 disables)
PAPER_MAX_IMAGE_COUNT=6

# LaTeX (Athena PDF compile)
TECTONIC_BIN=
LATEX_TIMEOUT_MS=120000

