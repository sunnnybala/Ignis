{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "mastra:dev": "mastra dev",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "copyfiles -u 1 \"src/assets/**/*\" dist",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier -w \"**/*.{ts,tsx,js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "db:reset": "node scripts/resetDb.js && npm run db:migrate",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "test:paper-variants": "npx tsx src/scripts/test-paper-workflow-variants.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/google-vertex": "^4.0.15",
    "@mastra/core": "^1.0.0-beta.17",
    "@mastra/express": "^0.1.0-beta.12",
    "@mastra/libsql": "^1.0.0-beta.10",
    "@mastra/loggers": "^1.0.0-beta.3",
    "@mastra/memory": "^1.0.0-beta.9",
    "@mastra/observability": "^1.0.0-beta.8",
    "@supabase/supabase-js": "^2.89.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "jose": "^6.1.3",
    "mastra": "^1.0.0-beta.12",
    "openai": "^4.59.0",
    "pg": "^8.16.3",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/coverage-v8": "^4.0.17",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
