VITE_API_BASE_URL=https://your-backend.railway.app
VITE_APP_ENV=production
VITE_FORMSPREE_ID=

# ============================
# AUTH (Supabase Auth)
# ============================
# Where to get these:
# Supabase Dashboard → Project Settings → API
# - Project URL  -> VITE_SUPABASE_URL
# - anon public  -> VITE_SUPABASE_ANON_KEY  (safe to expose in frontend; NOT the service role key)
#
# Used by the frontend to:
# - sign up / sign in (email+password)
# - sign in with Google OAuth
# - obtain an access token to send to the backend as:
#     Authorization: Bearer <access_token>
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: explicit OAuth redirect URL (if not set, we can compute from window.location.origin later)
# Example (prod): https://your-frontend.vercel.app
# Example (local): http://localhost:5173
VITE_AUTH_REDIRECT_URL=


