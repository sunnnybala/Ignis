# Modal runner (deployed on Modal, NOT used by the Node backend)
#
# These are optional overrides. If unset, the runner uses defaults:
# - Kaggle Secret name: ignis-kaggle
# - Dataset Volume name: ignis-datasets-cache
#
# Typically you set these as Modal app environment variables (or just keep defaults).

IGNIS_KAGGLE_SECRET_NAME=ignis-kaggle
IGNIS_DATASET_VOLUME_NAME=ignis-datasets-cache


